{
  "name": "marketplace-poster",
  "version": "1.0.0",
  "description": "Automação de postagens de imóveis no Facebook Marketplace - Magiore Imóveis",
  "author": "Magiore Imóveis",
  "main": "painel.js",
  "scripts": {
    "start": "node index.js",
    "post-agora": "node index.js --now",
    "testar": "node src/test-login.js",
    "painel": "electron painel.js",
    "build-win": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.magiore.marketplace-poster",
    "productName": "Magiore Marketplace Poster",
    "copyright": "Copyright © 2026 Magiore Imóveis",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "files": [
      "**/*",
      "!node_modules/.cache",
      "!dist",
      "!logs",
      "!temp-images",
      "!chrome-profile"
    ],
    "extraResources": [
      {
        "from": "src/",
        "to": "src/"
      },
      {
        "from": "views/",
        "to": "views/"
      },
      {
        "from": "assets/",
        "to": "assets/"
      },
      {
        "from": "index.js",
        "to": "index.js"
      },
      {
        "from": "package.json",
        "to": "package.json"
      }
    ]
  },
  "dependencies": {
    "axios": "^1.6.8",
    "dotenv": "^16.4.5",
    "electron-reload": "^2.0.0-alpha.1",
    "fs-extra": "^11.2.0",
    "googleapis": "^140.0.0",
    "node-cron": "^3.0.3",
    "node-notifier": "^10.0.1",
    "puppeteer": "^21.11.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "sharp": "^0.33.3",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "electron": "^42.0.1",
    "electron-builder": "^24.13.3"
  }
}
